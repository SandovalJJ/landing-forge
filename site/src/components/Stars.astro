---
interface Props { value: number | null; class?: string }
const { value, class: cls = "size-3.5" } = Astro.props;
const filled = Math.round(value ?? 0);
---

<span class="inline-flex items-center gap-0.5" aria-label={`${value ?? 0} de 5 estrellas`} role="img">
  {[1, 2, 3, 4, 5].map((i) => (
    <svg viewBox="0 0 20 20" class:list={[cls, i <= filled ? "fill-accent" : "fill-line"]} aria-hidden="true">
      <path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z" />
    </svg>
  ))}
</span>
