---
interface Props { value: number | null; class?: string }
const { value, class: cls = "size-4" } = Astro.props;
const filled = Math.round(value ?? 0);
---

<span class="inline-flex gap-0.5" role="img" aria-label={`${value ?? 0} de 5 estrellas`}>
  {[1, 2, 3, 4, 5].map((i) => (
    <svg viewBox="0 0 20 20" class={cls} aria-hidden="true">
      <path d="M10 2.2l2.4 5 5.4.7-4 3.8 1 5.4L10 14.5 5.2 17.1l1-5.4-4-3.8 5.4-.7z" fill={i <= filled ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
    </svg>
  ))}
</span>
