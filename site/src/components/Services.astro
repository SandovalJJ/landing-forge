---
import { copy, photo } from "../lib/site";
const img = photo(3);
---

<section id="servicios" class="scroll-mt-20">
  <div class="mx-auto grid max-w-7xl gap-14 px-4 py-24 sm:px-6 lg:grid-cols-12 lg:px-8">
    <!-- Columna fija a la izquierda (sticky) y lista editorial a la derecha -->
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28" data-reveal>
        <p class="section-label">02 — Qué ofrecemos</p>
        <h2 class="mt-4 text-4xl leading-tight font-bold tracking-tight sm:text-5xl">{copy.services_title}</h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{copy.services_intro}</p>
        <figure class="mt-10 hidden aspect-[5/4] overflow-hidden rounded-2xl border border-line lg:block">
          <img src={img.src} alt="" loading="lazy" class="size-full object-cover" />
        </figure>
      </div>
    </div>

    <ol class="divide-y divide-line border-y border-line lg:col-span-7">
      {copy.services.map((s, i) => (
        <li class="group relative grid grid-cols-[3rem_1fr] gap-x-4 py-8 transition-colors hover:bg-accent-soft/40 sm:grid-cols-[4rem_1fr_auto] sm:px-4" data-reveal>
          <span class="absolute inset-y-0 left-0 w-0.5 origin-top scale-y-0 bg-accent transition-transform duration-300 group-hover:scale-y-100" aria-hidden="true"></span>
          <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="text-xl font-semibold tracking-tight">{s.name}</h3>
            <p class="mt-2 max-w-prose leading-relaxed text-muted">{s.description}</p>
          </div>
          {s.tag && (
            <span class="col-start-2 mt-3 w-fit self-start rounded-full border border-line bg-surface px-2.5 py-1 text-xs font-medium sm:col-start-3 sm:mt-0">{s.tag}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
