---
import Stars from "./Stars.astro";
import { business, copy, directionsUrl, formatCount, formatRating, initials, photo, phoneHref, reviews, splitHighlight } from "../lib/site";

const { hero } = copy;
const [before, mark, after] = splitHighlight(hero.headline, hero.headline_highlight);
const featured = reviews[0];
const main = photo(0);
const second = photo(1);
---

<section class="relative isolate">
  <div class="grid-bg absolute inset-0 -z-10 h-[38rem]" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl gap-12 px-4 pt-12 pb-20 sm:px-6 lg:grid-cols-12 lg:gap-8 lg:px-8 lg:pt-20 lg:pb-28">
    <!-- Texto: columna propia, nunca encima de la foto -->
    <div class="flex flex-col justify-center lg:col-span-6 xl:col-span-7 lg:pr-8">
      <span class="eyebrow w-fit">
        <span class="size-1.5 rounded-full bg-accent"></span>
        {hero.eyebrow}
      </span>
      <h1 class="mt-6 text-[clamp(2.4rem,6vw,4.6rem)] leading-[1.02] font-extrabold tracking-[-0.035em]">
        {before}{mark && <span class="bg-gradient-to-r from-accent to-accent-2 bg-clip-text text-transparent">{mark}</span>}{after}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{hero.subheadline}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={phoneHref() ? `tel:${phoneHref()}` : "#visita"} class="btn-primary">
          {hero.primary_cta}
          <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
        <a href={directionsUrl()} target="_blank" rel="noopener" class="btn-ghost">{hero.secondary_cta}</a>
      </div>

      <dl class="mt-12 grid max-w-xl grid-cols-3 divide-x divide-line border-y border-line py-5 text-sm">
        <div class="pr-4">
          <dt class="text-muted">Google</dt>
          <dd class="mt-1 flex items-center gap-2 font-display text-2xl font-bold">{formatRating(business.rating)} <Stars value={business.rating} class="size-3" /></dd>
        </div>
        <div class="px-4">
          <dt class="text-muted">Reseñas</dt>
          <dd class="mt-1 font-display text-2xl font-bold">{formatCount(business.review_count)}</dd>
        </div>
        <div class="pl-4">
          {business.hours?.length ? (
            <>
              <dt class="text-muted">Hoy</dt>
              <dd class="mt-1 font-display text-base leading-8 font-semibold" data-today-hours>—</dd>
            </>
          ) : (
            <>
              <dt class="text-muted">Tipo</dt>
              <dd class="mt-1 font-display text-base leading-tight font-semibold">{business.category}</dd>
            </>
          )}
        </div>
      </dl>
    </div>

    <!-- Composición de fotos asimétrica -->
    <div class="relative lg:col-span-6 xl:col-span-5">
      <figure class="relative ml-auto aspect-[4/5] w-[88%] overflow-hidden rounded-3xl border border-line bg-accent-soft shadow-2xl shadow-ink/10">
        <img src={main.src} alt={`${business.name}`} class="size-full object-cover" fetchpriority="high" />
      </figure>
      <figure class="absolute -bottom-8 left-0 aspect-square w-[42%] overflow-hidden rounded-2xl border-4 border-bg bg-accent-soft shadow-xl shadow-ink/10">
        <img src={second.src} alt="" class="size-full object-cover" loading="lazy" />
      </figure>
      {featured && (
        <blockquote class="absolute top-8 -left-2 w-64 rounded-2xl border border-line bg-surface/90 p-4 text-sm shadow-xl shadow-ink/10 backdrop-blur sm:-left-6 lg:-left-10">
          <Stars value={featured.rating} />
          <p class="mt-2 line-clamp-3 leading-snug">“{featured.text}”</p>
          <footer class="mt-3 flex items-center gap-2 text-xs text-muted">
            <span class="grid size-6 place-items-center rounded-full bg-accent-soft text-[10px] font-bold text-accent">{initials(featured.author)}</span>
            {featured.author}
          </footer>
        </blockquote>
      )}
    </div>
  </div>
</section>
