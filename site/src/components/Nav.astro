---
import { business, copy, formatRating, phoneHref } from "../lib/site";
const links = [
  ["Por qué venir", "#propuesta"],
  ["Qué ofrecemos", "#servicios"],
  ["Reseñas", "#resenas"],
  ["Visítanos", "#visita"],
];
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-bg/75 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="#" class="flex items-center gap-2.5 font-display text-[15px] font-bold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-accent text-sm text-accent-fg">{business.name[0]}</span>
      <span class="max-w-[14ch] truncate sm:max-w-none">{business.name}</span>
    </a>
    <ul class="hidden items-center gap-1 text-sm text-muted md:flex">
      {links.map(([label, href]) => (
        <li><a href={href} class="rounded-full px-3 py-1.5 transition hover:bg-accent-soft hover:text-ink">{label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      {business.rating && (
        <span class="hidden items-center gap-1 text-sm font-semibold lg:flex">
          <svg viewBox="0 0 20 20" class="size-4 fill-accent" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z" /></svg>
          {formatRating(business.rating)}
        </span>
      )}
      <a href={phoneHref() ? `tel:${phoneHref()}` : "#visita"} class="btn-primary !px-4 !py-2">{copy.hero.primary_cta}</a>
    </div>
  </nav>
</header>
