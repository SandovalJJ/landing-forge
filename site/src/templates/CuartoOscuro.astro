---
import OscuroBase from "../layouts/OscuroBase.astro";
import Print from "../components/oscuro/Print.astro";
import Station from "../components/oscuro/Station.astro";
import {
  business, copy, photos, photo, reviews, hours,
  directionsUrl, mapsEmbed, phoneHref, reserveHref, reserveVia, lcdHours,
  formatCount, formatRating, splitHighlight,
} from "../lib/site";

const { hero, value_proposition: vp } = copy;
const [before, mark, after] = splitHighlight(hero.headline, hero.headline_highlight);
const external = (href: string) => /^https?:/.test(href);
const reserve = reserveHref();

const stations = [
  ["01", "Exponer", "#exponer"],
  ["02", "Tira de prueba", "#prueba"],
  ["03", "Revelar", "#revelar"],
  ["04", "Fijar", "#fijar"],
  ["05", "Lavar", "#lavar"],
  ["06", "Secar", "#secar"],
];
// Pasos de la tira de prueba: de exposición corta (claro) a larga (oscuro).
const strip = [
  { bg: "bg-tint", fg: "text-ink", sub: "text-deeproom", step: "-1" },
  { bg: "bg-deeproom", fg: "text-enamel", sub: "text-tint", step: "0" },
  { bg: "bg-ink", fg: "text-enamel", sub: "text-safelight", step: "+1" },
];
const line = photos.slice(0, 6);

// Reseñas largas: un extracto cortado en límite de palabra; el texto completo queda a un clic.
const excerpt = (text: string, max = 340) => {
  if (text.length <= max + 60) return { short: text, cut: false };
  return { short: text.slice(0, text.lastIndexOf(" ", max)).replace(/[\s,.;:–-]+$/, ""), cut: true };
};
// "Fecha de edición: hace un año" → "hace un año"; ISO → "oct 2025".
const when = (w: string | null | undefined) => {
  if (!w) return "Google";
  const iso = Date.parse(w);
  if (/^\d{4}-\d{2}/.test(w) && !Number.isNaN(iso)) {
    return new Date(iso).toLocaleDateString("es-CO", { month: "short", year: "numeric" });
  }
  return w.includes(":") ? w.split(":").pop()!.trim() : w;
};
const tilt = ["-rotate-2", "rotate-1", "-rotate-1", "rotate-2", "-rotate-1", "rotate-1"];
---

<OscuroBase>
  <!-- Franja de luz de seguridad -->
  <header class="sticky top-0 z-40 border-b-[1.5px] border-ink bg-safelight">
    <nav class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-4 sm:px-8" aria-label="Principal">
      <a href="#exponer" class="font-label text-2xl leading-none font-extrabold tracking-wide uppercase">{business.name}</a>
      <ol class="hidden items-center gap-1 xl:flex">
        {stations.map(([n, name, href]) => (
          <li><a href={href} class="label inline-flex items-center gap-2 px-2.5 py-2 hover:bg-ink hover:text-safelight-hi"><span class="lcd text-[.7rem] tracking-normal">{n}</span>{name}</a></li>
        ))}
      </ol>
      <a href={reserve} target={external(reserve) ? "_blank" : undefined} rel="noopener" class="btn-print !min-h-10 !px-4 !text-xs">{hero.primary_cta}</a>
    </nav>
  </header>

  <main>
    <!-- 01 Exponer -->
    <section id="exponer" class="mx-auto grid max-w-[1440px] gap-12 px-4 pt-10 pb-16 sm:px-8 lg:grid-cols-12 lg:gap-10 lg:pt-14 lg:pb-20" aria-labelledby="titular">
      <div class="flex flex-col justify-center lg:col-span-7">
        <h1 id="titular" class="font-pencil text-[clamp(2.6rem,5.8vw,5.4rem)] leading-[1.14] uppercase">
          {before}{mark && <span class="bg-ink px-2 leading-[1.14] text-safelight-hi [box-decoration-break:clone] [padding-block:0.02em]">{mark}</span>}{after}
        </h1>
        <p class="mt-7 max-w-[52ch] text-[1.05rem] leading-relaxed">{hero.subheadline}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={reserve} target={external(reserve) ? "_blank" : undefined} rel="noopener" class="btn-print">
            {hero.primary_cta}
            <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </a>
          <a href={directionsUrl()} target="_blank" rel="noopener" class="btn-line">{hero.secondary_cta}</a>
        </div>
        <p class="label mt-4 text-deeproom">Reservas por {reserveVia()}</p>

        <!-- Ficha de la sesión -->
        <dl class="mt-12 max-w-xl border-t-[1.5px] border-ink text-sm">
          {[
            ["Tipo", business.category],
            ["Google", null],
            ["Dónde", business.short_address ?? business.address],
          ].map(([k, v]) => (
            <div class="flex items-baseline justify-between gap-8 border-b border-ink/40 py-3">
              <dt class="label text-deeproom">{k}</dt>
              <dd class="text-right">
                {v ?? <><span class="lcd">{formatRating(business.rating).replace(",", ".")}</span> · {formatCount(business.review_count)} reseñas</>}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Bandeja de revelado con el cronómetro -->
      <div class="relative lg:col-span-5" data-dev-state="developing">
        <div class="mb-4 flex items-stretch justify-between gap-4 bg-ink p-4 text-safelight-hi shadow-[0_14px_24px_-10px_rgb(75_46_7/.6)] sm:p-5">
          {hours.length > 0 ? (
            <div>
              <p class="label text-tint">Hoy abre</p>
              {hours.map((h, i) => {
                const { digits, suffix } = lcdHours(h.hours);
                return (
                  <p data-today-only={i} hidden={i !== 0} class="mt-1">
                    <span class="lcd text-[clamp(2rem,4vw,3rem)]">{digits}</span>
                    <span class="label ml-2 text-tint">{suffix}</span>
                  </p>
                );
              })}
            </div>
          ) : (
            <div>
              <p class="label text-tint">Google</p>
              <p class="lcd mt-1 text-[clamp(2rem,4vw,3rem)]">{formatRating(business.rating).replace(",", ".")}</p>
            </div>
          )}
          <div class="text-right">
            <p class="label text-tint"><span class="dev-label">Revelando</span></p>
            <p class="lcd mt-1 text-[clamp(1.4rem,2.4vw,2rem)]" data-dev-timer="copia-principal" data-dev-seconds="75">00:00</p>
          </div>
        </div>
        <div class="tray">
          <Print id="copia-principal" photo={photo(0)} alt={business.name} ratio="4 / 3" eager border={false} />
        </div>
      </div>
    </section>

    <!-- Estaciones, como en la mesa del cuarto oscuro -->
    <ol class="mx-auto grid max-w-[1440px] grid-cols-2 border-y-[1.5px] border-ink sm:grid-cols-3 lg:grid-cols-6" aria-label="Recorrido de la página">
      {stations.map(([n, name, href]) => (
        <li class="border-ink not-last:border-r-[1.5px] max-lg:[&:nth-child(3)]:border-r-0 max-lg:nth-[-n+3]:border-b-[1.5px] max-sm:[&:nth-child(even)]:border-r-0 max-sm:nth-[-n+4]:border-b-[1.5px]">
          <a href={href} class="flex h-full items-baseline gap-3 px-4 py-4 hover:bg-ink hover:text-safelight-hi sm:px-6"><span class="lcd text-sm">{n}</span><span class="label">{name}</span></a>
        </li>
      ))}
    </ol>

    <!-- 02 Tira de prueba -->
    <section id="prueba" class="mx-auto max-w-[1440px] scroll-mt-16 px-4 py-24 sm:px-8">
      <Station n="02" name="Tira de prueba" title={vp.title} />
      <p class="mt-8 max-w-[62ch] text-[1.05rem] leading-relaxed">{vp.body}</p>
      <div class="mt-12 grid border-[1.5px] border-ink md:grid-cols-3">
        {vp.pillars.map((p, i) => {
          const s = strip[i % strip.length];
          return (
            <article class:list={["flex flex-col p-7 sm:p-9", s.bg, s.fg]}>
              <h3 class="font-label text-3xl leading-tight font-bold uppercase">{p.title}</h3>
              <p class="mt-3 leading-relaxed">{p.body}</p>
              <blockquote class="mt-auto pt-8">
                <p class="font-pencil text-xl leading-snug">“{p.evidence_quote}”</p>
                <footer class:list={["label mt-4 flex items-baseline justify-between gap-4", s.sub]}>
                  <span>{p.evidence_author} · Google</span>
                  <span aria-label={`Paso de exposición ${s.step}`}><span class="lcd tracking-normal">{s.step}</span></span>
                </footer>
              </blockquote>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 03 Revelar -->
    <section id="revelar" class="mx-auto max-w-[1440px] scroll-mt-16 px-4 py-24 sm:px-8">
      <Station n="03" name="Revelar" title={copy.services_title} />
      <p class="mt-8 max-w-[62ch] text-[1.05rem] leading-relaxed">{copy.services_intro}</p>
      <ol class="mt-12 border-t-[1.5px] border-ink">
        {copy.services.map((s, i) => (
          <li class="grid grid-cols-[5.5rem_1fr] items-start gap-x-5 gap-y-3 border-b border-ink/50 py-6 sm:grid-cols-[3rem_9rem_1fr_auto] sm:items-center sm:gap-x-8">
            <span class="lcd hidden text-lg sm:block">{String(i + 1).padStart(2, "0")}</span>
            <Print photo={photo(i + 1)} ratio="4 / 3" border={false} class="outline outline-1 outline-ink" />
            <div>
              <h3 class="font-label text-2xl leading-tight font-bold uppercase">{s.name}</h3>
              <p class="mt-1.5 max-w-[60ch] leading-relaxed">{s.description}</p>
            </div>
            {s.tag && <span class="label col-start-2 w-fit border-[1.5px] border-ink px-2.5 py-1.5 sm:col-start-4">{s.tag}</span>}
          </li>
        ))}
      </ol>
    </section>

    <!-- 04 Fijar: lo que dicen, en copias sobre papel esmaltado -->
    <section id="fijar" class="scroll-mt-16 border-y-[1.5px] border-ink bg-deeproom py-24 text-enamel">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-8">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b-[1.5px] border-tint pb-5">
          <h2 class="max-w-[22ch] font-pencil text-[clamp(2rem,4.4vw,3.6rem)] leading-[1.08] uppercase">{copy.reviews_title}</h2>
          <p class="label shrink-0 pb-2 text-tint"><span class="lcd mr-2 text-sm tracking-normal">04</span>Fijar</p>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-4">
          <p class="lcd text-6xl text-safelight-hi">{formatRating(business.rating).replace(",", ".")}</p>
          <p class="max-w-[50ch] leading-relaxed">{copy.reviews_intro}</p>
        </div>
        <div class="mt-12 columns-1 gap-5 md:columns-2 xl:columns-3">
          {reviews.map((r) => (
            <figure class="mb-5 break-inside-avoid border-[1.5px] border-ink bg-enamel p-6 text-ink shadow-[0_12px_24px_-12px_rgb(0_0_0/.6)]">
              <div class="flex gap-1" role="img" aria-label={`${r.rating ?? 0} de 5 estrellas`}>
                {[1, 2, 3, 4, 5].map((n) => <span class:list={["h-3 w-6 border border-ink", n <= (r.rating ?? 0) ? "bg-ink" : "bg-transparent"]}></span>)}
              </div>
              {(() => {
                const { short, cut } = excerpt(r.text);
                return cut ? (
                  <details class="group mt-4">
                    <summary class="cursor-pointer list-none leading-relaxed marker:hidden">
                      <blockquote class="group-open:hidden">{short}… <span class="font-semibold underline">seguir leyendo</span></blockquote>
                    </summary>
                    <blockquote class="leading-relaxed">{r.text}</blockquote>
                  </details>
                ) : <blockquote class="mt-4 leading-relaxed">{r.text}</blockquote>;
              })()}
              <figcaption class="label mt-5 flex justify-between gap-4 border-t border-ink/40 pt-3 text-deeproom">
                <span>{r.author}</span><span class="text-right">{when(r.when)}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 05 Lavar: la historia y lo que conviene saber -->
    <section id="lavar" class="mx-auto max-w-[1440px] scroll-mt-16 px-4 py-24 sm:px-8">
      <Station n="05" name="Lavar" title={copy.story_title} />
      <div class="mt-10 grid gap-14 lg:grid-cols-12">
        <p class="text-[1.05rem] leading-relaxed lg:col-span-5">{copy.story_body}</p>
        <dl class="border-t-[1.5px] border-ink lg:col-span-6 lg:col-start-7">
          {copy.faq.map((f) => (
            <details class="group border-b border-ink/50">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-label text-xl font-bold uppercase marker:hidden">
                <dt>{f.question}</dt>
                <span class="font-pencil text-3xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <dd class="max-w-[60ch] pb-6 leading-relaxed">{f.answer}</dd>
            </details>
          ))}
        </dl>
      </div>
    </section>

    <!-- 06 Secar: la cuerda con las copias y la visita -->
    <section id="secar" class="scroll-mt-16 pt-12 pb-24">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-8">
        <Station n="06" name="Secar" title={copy.visit_title} />
      </div>
      <div class="relative mt-14 overflow-x-auto pb-6 [scrollbar-width:thin]">
        <div class="absolute top-3 right-0 left-0 h-[1.5px] min-w-[1200px] bg-ink" aria-hidden="true"></div>
        <ul class="flex w-max gap-8 px-4 sm:px-8">
          {line.map((p, i) => (
            <li class:list={["relative origin-top pt-1", tilt[i % tilt.length]]}>
              <span class="absolute top-0 left-1/2 z-10 h-6 w-3 -translate-x-1/2 border border-ink bg-deeproom" aria-hidden="true"></span>
              <Print photo={p} ratio={(p.width && p.height && p.height > p.width) ? "3 / 4" : "4 / 3"} class:list={[(p.width && p.height && p.height > p.width) ? "w-52 sm:w-60" : "w-72 sm:w-80", "mt-3 shadow-[0_14px_22px_-12px_rgb(75_46_7/.7)]"]} />
            </li>
          ))}
        </ul>
      </div>

      <div class="mx-auto mt-16 grid max-w-[1440px] gap-12 px-4 sm:px-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="max-w-[52ch] text-[1.05rem] leading-relaxed">{copy.visit_note}</p>
          <dl class="mt-8 border-t-[1.5px] border-ink text-sm">
            <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-ink/50 py-4">
              <dt class="label text-deeproom">Dirección</dt>
              <dd><a href={directionsUrl()} target="_blank" rel="noopener" class="underline">{business.address}</a></dd>
            </div>
            {business.phone && (
              <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-ink/50 py-4">
                <dt class="label text-deeproom">Teléfono</dt>
                <dd><a href={`tel:${phoneHref()}`} class="underline">{business.phone}</a></dd>
              </div>
            )}
            {business.website && (
              <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-ink/50 py-4">
                <dt class="label text-deeproom">{reserveVia() === "Instagram" ? "Instagram" : "Web"}</dt>
                <dd><a href={business.website} target="_blank" rel="noopener" class="underline break-all">{business.website.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a></dd>
              </div>
            )}
          </dl>
          {hours.length > 0 && (
            <table class="mt-8 w-full text-sm">
              <caption class="label pb-3 text-left text-deeproom">Horario</caption>
              <tbody>
                {hours.map((h, i) => (
                  <tr data-day={i} class="border-b border-ink/40 data-today:bg-ink data-today:text-safelight-hi">
                    <th scope="row" class="py-2.5 pl-2 text-left font-normal">{h.day}</th>
                    <td class="lcd py-2.5 pr-2 text-right text-xs">{lcdHours(h.hours).digits} <span class="label font-mono">{lcdHours(h.hours).suffix}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
        <div class="tray min-h-96 lg:col-span-7">
          <iframe title={`Mapa de ${business.name}`} src={mapsEmbed()} class="size-full min-h-96 [filter:sepia(.35)_saturate(.9)]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <!-- Luces apagadas: cierre -->
    <section class="bg-ink text-enamel">
      <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-4 py-20 sm:px-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <h2 class="font-pencil text-[clamp(2.4rem,5vw,4.4rem)] leading-[1.05] text-safelight-hi uppercase">{copy.closing_title}</h2>
          <p class="mt-5 max-w-[56ch] text-[1.05rem] leading-relaxed">{copy.closing_body}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={reserve} target={external(reserve) ? "_blank" : undefined} rel="noopener" class="btn-print">{hero.primary_cta}</a>
          <a href={directionsUrl()} target="_blank" rel="noopener" class="btn-line !border-enamel !text-enamel hover:!bg-enamel hover:!text-ink">{hero.secondary_cta}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t-[1.5px] border-ink bg-safelight">
    <div class="mx-auto flex max-w-[1440px] flex-col gap-2 px-4 py-6 text-sm sm:flex-row sm:justify-between sm:px-8">
      <p>© {new Date().getFullYear()} {business.name}</p>
      <p class="label text-deeproom">Fotos y reseñas: Google Maps</p>
    </div>
  </footer>
</OscuroBase>

<style>
  [data-dev-state="fixed"] .dev-label { font-size: 0; }
  [data-dev-state="fixed"] .dev-label::after { content: "Fijado"; font-size: .72rem; }
</style>
